import asyncio
import os
import sys
import logging
from logging.config import fileConfig
from sqlalchemy import pool
from sqlalchemy.engine import Connection
from sqlalchemy.ext.asyncio import async_engine_from_config
from alembic import context

# Configurar logging
logger = logging.getLogger("alembic")

# Garantir que o diretório raiz do projeto esteja no PYTHONPATH
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

# Importar Base e modelos com tratamento de erros
try:
    from app.models import Base
    # Importar modelos específicos para garantir que sejam incluídos nas migrações
    # Se algum modelo não existir, o log mostrará o erro mas não falhará
    try:
        from app.models.client import Client
        logger.info("Modelo Client importado com sucesso")
    except ImportError as e:
        logger.warning(f"Não foi possível importar o modelo Client: {e}")
    
    try:
        from app.models.project import Project
        logger.info("Modelo Project importado com sucesso")
    except ImportError as e:
        logger.warning(f"Não foi possível importar o modelo Project: {e}")
    
    try:
        from app.models.activity import Activity
        logger.info("Modelo Activity importado com sucesso")
    except ImportError as e:
        logger.warning(f"Não foi possível importar o modelo Activity: {e}")
except ImportError as e:
    logger.error(f"Erro ao importar Base ou modelos: {e}")
    logger.error("Verifique se o PYTHONPATH está configurado corretamente")
    sys.exit(1)

config = context.config

# Sobrescrever a URL do banco com a variável de ambiente
if "DATABASE_URL" in os.environ:
    logger.info(f"Usando DATABASE_URL do ambiente: {os.environ['DATABASE_URL'].split('@')[0]}@...")
    config.set_main_option("sqlalchemy.url", os.environ["DATABASE_URL"])
else:
    logger.warning("Variável DATABASE_URL não encontrada no ambiente")
    # Verificar se há uma URL configurada no alembic.ini
    if not config.get_main_option("sqlalchemy.url"):
        logger.error("Nenhuma URL de banco de dados configurada. Defina DATABASE_URL ou configure no alembic.ini")
        sys.exit(1)

if config.config_file_name is not None:
    fileConfig(config.config_file_name)

target_metadata = Base.metadata

def run_migrations_offline() -> None:
    """Run migrations in 'offline' mode."""
    url = config.get_main_option("sqlalchemy.url")
    context.configure(
        url=url,
        target_metadata=target_metadata,
        literal_binds=True,
        dialect_opts={"paramstyle": "named"},
    )
    with context.begin_transaction():
        context.run_migrations()

def do_run_migrations(connection: Connection) -> None:
    """Run migrations with the given connection."""
    context.configure(connection=connection, target_metadata=target_metadata)
    with context.begin_transaction():
        context.run_migrations()

async def run_async_migrations() -> None:
    """Run migrations asynchronously."""
    try:
        connectable = async_engine_from_config(
            config.get_section(config.config_ini_section, {}),
            prefix="sqlalchemy.",
            poolclass=pool.NullPool,
        )
        async with connectable.connect() as connection:
            await connection.run_sync(do_run_migrations)
        await connectable.dispose()
    except Exception as e:
        logger.error(f"Erro durante a execução das migrações: {e}")
        raise

def run_migrations_online() -> None:
    """Run migrations in 'online' mode."""
    try:
        asyncio.run(run_async_migrations())
    except Exception as e:
        logger.error(f"Erro ao executar migrações assíncronas: {e}")
        sys.exit(1)

if context.is_offline_mode():
    logger.info("Executando migrações no modo offline")
    run_migrations_offline()
else:
    logger.info("Executando migrações no modo online")
    run_migrations_online() 