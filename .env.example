# Database configuration
# Replace user, password, host, port and database_name with appropriate values
DATABASE_URL=postgresql://user:password@localhost:5432/database_name

# Secret key for JWT token generation
# IMPORTANT: In production, use a strong and secure key (minimum 32 characters)
# Example of how to generate a secure key:
# python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=replace_with_secure_secret_key

# Algorithm used for JWT signature
# Recommended to keep HS256 unless there's a specific need
ALGORITHM=HS256

# JWT token expiration time in minutes
# Adjust according to application security requirements
ACCESS_TOKEN_EXPIRE_MINUTES=30 